---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGallery from "../components/react/PhotoGallery";
import gallery from "../data/gallery.json";

const TABS = ["all", "yatra", "invited talks", "virasat", "performances", "architecture", "samagam", "workshop","sangam"];

const urlFilter = Astro.url.searchParams.get("filter")?.toLowerCase();
const initialFilter = urlFilter && TABS.includes(urlFilter) ? urlFilter : "all";
---

<BaseLayout title="Gallery" description="Moments from IndicSense — workshops, yātrās, festivals, and cultural events.">
  <section class="mx-auto max-w-7xl px-6 py-16 text-center">
    <p class="section-label">Visual Chronicle</p>
    <h1 class="font-display text-5xl text-maroon-deep mt-2">Gallery</h1>
    <p class="mt-4 text-stone max-w-xl mx-auto">
      A walk down the memory lane of IndicSense. Explore the moments captured in our gallery, showcasing the vibrant tapestry of our community.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-32">
    <PhotoGallery client:load images={gallery} initialFilter={initialFilter} />
  </section>
</BaseLayout>
