---
import BaseLayout from "../../layouts/BaseLayout.astro";
import samagamData from "../../data/events/samagam.json";
import sangamData from "../../data/events/sangam.json";
import virasatData from "../../data/events/virasat.json";


type EventData = {
  title: string;
  description: string;
  subtitle: string;
  sanskrit: string;
  heroImage: string;
  slug: string;
  isSangam?: boolean;

  isRegistrationOpen?: boolean;
  registrationFormUrl?: string;

  isGuidelinesUploaded?: boolean;
  guidelinesPdfUrl?: string;

  upcoming: {
    date: string;
    venue: string;
    status: string;
  };

  highlights: string[];
};

export function getStaticPaths() {
  return [
    {
      params: { slug: "samagam" },
      props: { event: samagamData },
    },
    {
      params: { slug: "sangam" },
      props: { event: sangamData },
    },
    {
      params: { slug: "virasat" },
      props: { event: virasatData },
    },
  ];
}

const { event } = Astro.props as { event: EventData };

const isRegistrationOpen = event.isRegistrationOpen ?? false;
const registrationFormUrl = event.registrationFormUrl ?? "";

const isGuidelinesUploaded = event.isGuidelinesUploaded ?? false;
const guidelinesPdfUrl = event.guidelinesPdfUrl ?? "";
---

<BaseLayout title={event.title} description={event.description}>

  <!-- HERO -->
  <section class="relative min-h-[50vh] flex items-end">
    <div class="absolute inset-0">
      <img
        src={event.heroImage}
        alt={event.title}
        class="w-full h-full object-cover"
      />

      <div
        class="absolute inset-0 bg-gradient-to-t from-parchment via-parchment/60 to-transparent"
      ></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-16 w-full">
      <p class="section-label">{event.subtitle}</p>

      <h1
        class:list={[
          "font-display text-5xl md:text-6xl",
          event.isSangam
            ? "text-teal-deep"
            : "text-maroon-deep"
        ]}
      >
        {event.title}
      </h1>

      <p class="font-sanskrit text-lg text-stone mt-2 iast">
        {event.sanskrit}
      </p>
    </div>
  </section>


  <!-- EVENT CONTENT -->
  <section class="mx-auto max-w-4xl px-6 py-16">

    <!-- DESCRIPTION -->
    <p class="prose-indic text-lg">
      {event.description}
    </p>


    <!-- UPCOMING -->
    <div class="mt-12 manuscript-card p-8">
      <p class="section-label mb-4">
        Upcoming
      </p>

      <dl class="grid gap-4 sm:grid-cols-3 font-ui text-sm">

        <div>
          <dt class="text-stone-light uppercase tracking-wider text-xs">
            When
          </dt>

          <dd class="text-maroon-deep mt-1">
            {event.upcoming.date}
          </dd>
        </div>

        <div>
          <dt class="text-stone-light uppercase tracking-wider text-xs">
            Where
          </dt>

          <dd class="text-maroon-deep mt-1">
            {event.upcoming.venue}
          </dd>
        </div>

        <div>
          <dt class="text-stone-light uppercase tracking-wider text-xs">
            Status
          </dt>

          <dd class="text-maroon-deep mt-1">
            {event.upcoming.status}
          </dd>
        </div>

      </dl>
    </div>


    <!-- HIGHLIGHTS -->
    <div class="mt-12">
      <p class="section-label mb-4">
        Highlights
      </p>

      <ul class="space-y-3">
        {event.highlights.map((h) => (
          <li class="flex gap-3 text-stone">
            <span class="text-gold shrink-0">
              ◆
            </span>

            {h}
          </li>
        ))}
      </ul>
    </div>


    <!-- BUTTONS -->
    <div class="mt-16 flex flex-wrap gap-4">

      <!-- ALL EVENTS -->
      <a
        href="/events"
        class="btn-ghost"
      >
        ← All Events
      </a>


      <!-- EVENT GALLERY -->
      <a
        href={`/gallery?filter=${event.slug}`}
        class="btn-primary"
      >
        Event Gallery
      </a>


      <!-- REGISTER NOW -->
      <button
        id="register-btn"
        type="button"
        class="btn-primary"
        data-open={isRegistrationOpen}
        data-url={registrationFormUrl}
      >
        Register Now
      </button>


      <!-- GUIDELINES -->
      {isGuidelinesUploaded && guidelinesPdfUrl ? (
        <a
          href={guidelinesPdfUrl}
          download
          class="bg-maroon hover:bg-maroon-deep text-parchment px-6 py-2.5 rounded-lg font-ui text-sm font-medium transition-colors shadow-sm inline-flex items-center justify-center gap-2"
        >
          Guidelines
        </a>
      ) : (
        <button
          id="guidelines-btn"
          type="button"
          class="btn-primary"
        >
          Guidelines
        </button>
      )}

    </div>

    <!-- CUSTOM MODAL -->
    <div
      id="custom-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
    >
      <div class="bg-parchment rounded-2xl p-8 max-w-md w-full mx-4 manuscript-card relative">
        <button
          id="modal-close"
          type="button"
          class="absolute top-4 right-4 text-stone-light hover:text-maroon-deep transition-colors"
          aria-label="Close modal"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <h3 id="modal-title" class="font-display text-2xl text-maroon-deep mb-4"></h3>
        <p id="modal-message" class="text-stone mb-6"></p>
        <button
          id="modal-ok"
          type="button"
          class="btn-primary w-full"
        >
          Okay
        </button>
      </div>
    </div>

  </section>

</BaseLayout>


<script>
  const registerButton =
    document.getElementById("register-btn");

  const guidelinesButton =
    document.getElementById("guidelines-btn");

  const modal = document.getElementById("custom-modal");
  const modalTitle = document.getElementById("modal-title");
  const modalMessage = document.getElementById("modal-message");
  const modalClose = document.getElementById("modal-close");
  const modalOk = document.getElementById("modal-ok");

  function openModal(title, message) {
    modalTitle.textContent = title;
    modalMessage.textContent = message;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    modalOk.focus();
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  modalClose?.addEventListener("click", closeModal);
  modalOk?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
  });


  /* REGISTER NOW */
  registerButton?.addEventListener("click", () => {
    const isOpen =
      registerButton.dataset.open === "true";

    const url =
      registerButton.dataset.url;


    if (isOpen && url) {
      window.open(
        url,
        "_blank",
        "noopener,noreferrer"
      );
    } else {
      openModal("Registration Closed", "Registration is currently closed.");
    }
  });


  /* GUIDELINES */
  guidelinesButton?.addEventListener("click", () => {
    openModal("Guidelines Unavailable", "Guidelines are not available yet.");
  });
</script>