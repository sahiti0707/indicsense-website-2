---
import BaseLayout from "../layouts/BaseLayout.astro";
import SanityArticleCard from "../components/SanityArticleCard.astro";
import { client } from "../lib/sanity";

interface Article {
  _id: string;
  title: string;
  slug: string;
  publishedAt: string;
  body: any;
}

const articles = await client.fetch<Article[]>(`
  *[_type == "post"] | order(publishedAt desc) {
    _id,
    title,
    "slug": slug.current,
    publishedAt,
    body
  }
`);
---

<BaseLayout
  title="Vṛttāntam"
  description="Intellectual articles from IndicSense — Dharma, Itihāsa, philosophy, arts, and more."
>
  <section class="relative py-24 overflow-hidden">
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: url('/images/inspo/WhatsApp Image 2026-05-24 at 11.54.44-937a119a-2423-42ef-b2d9-8d3e46e118e7.png'); background-size: cover; background-position: center;"
    ></div>

    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <p class="section-label">Intellectual Archive</p>

      <h1 class="font-display text-5xl md:text-6xl text-maroon-deep mt-2">
        Vṛttāntam
      </h1>

      <p class="font-sanskrit text-xl text-stone mt-4 iast">
        vṛttāntam — the chronicle
      </p>

      <p class="mt-6 text-stone max-w-2xl mx-auto">
        Serious writing on civilizational inquiry. Articles are published through IndicSense.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-32">
    {articles.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
      <>  <SanityArticleCard
    title={article.title}
    slug={article.slug}
    publishedAt={article.publishedAt}
  />
</>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 manuscript-card">
        <p class="text-stone mb-4">
          No articles have been published yet.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
