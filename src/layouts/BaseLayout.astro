---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = site.name,
  description = site.description,
  image = "/images/logos/logo-light.png",
} = Astro.props;

const fullTitle = title === site.name ? `${site.name} · ${site.institution}` : `${title} · ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/logos/logo-light.png" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&family=Tiro+Devanagari+Sanskrit:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-20">
      <slot />
    </main>
    <Footer />
    <div id="custom-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
      <div class="bg-cream rounded-xl shadow-2xl p-8 max-w-lg w-full mx-4 border-2 border-maroon/20">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-2xl font-display font-semibold text-maroon-deep" id="modal-title">Notice</h3>
          <button id="modal-close" class="text-stone hover:text-maroon text-3xl font-bold w-8 h-8 flex items-center justify-center rounded hover:bg-maroon/10 transition-colors">
            ✕
          </button>
        </div>
        <div class="text-stone font-ui leading-relaxed" id="modal-content">
        </div>
        <div class="mt-8 flex justify-end">
          <button id="modal-confirm" class="btn-primary px-6 py-2">OK</button>
        </div>
      </div>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const registerBtn = document.getElementById('register-btn');
        const guidelinesBtn = document.getElementById('guidelines-btn');
        const modal = document.getElementById('custom-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalContent = document.getElementById('modal-content');
        const modalClose = document.getElementById('modal-close');
        const modalConfirm = document.getElementById('modal-confirm');

        function showModal(title, message) {
          modalTitle.textContent = title;
          modalContent.innerHTML = message;
          modal.classList.remove('hidden');
          modal.setAttribute('aria-hidden', 'true');
        }

        function hideModal() {
          modal.classList.add('hidden');
          modal.setAttribute('aria-hidden', 'false');
        }

        if (registerBtn) {
          registerBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const isOpen = registerBtn.getAttribute('data-open') === 'true';
            const url = registerBtn.getAttribute('data-url');
            
            if (isOpen && url) {
              window.open(url, '_blank');
            } else {
              const status = !isOpen ? 'Registration is currently closed' : 'No registration URL available';
              showModal('Registration Notice', `<p class="mb-4">${status}</p><p class="text-sm text-stone-light">Please check back later or contact us for more information.</p>`);
            }
          });
        }

        if (guidelinesBtn) {
          guidelinesBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const isUploaded = guidelinesBtn.getAttribute('data-uploaded') === 'true';
            const url = guidelinesBtn.getAttribute('data-url');
            
            if (isUploaded && url) {
              window.open(url, '_blank');
            } else {
              const status = !isUploaded ? 'Guidelines are not yet uploaded' : 'No guidelines PDF available';
              showModal('Guidelines Notice', `<p class="mb-4">${status}</p><p class="text-sm text-stone-light">Please check back later or contact us for assistance.</p>`);
            }
          });
        }

        modalClose.addEventListener('click', hideModal);
        modalConfirm.addEventListener('click', hideModal);
        
        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            hideModal();
          }
        });
        
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            hideModal();
          }
        });
      });
    </script>
  </body>
</html>
