---
interface Props {
  title: string;
  slug: string;
  publishedAt: string;
  imageUrl?: string;
}

const { title, slug, publishedAt, imageUrl } = Astro.props;

const date = publishedAt
  ? new Date(publishedAt).toLocaleDateString("en-IN", {
      day: "numeric",
      month: "short",
      year: "numeric",
    })
  : "";
---

<article class="manuscript-card overflow-hidden flex flex-col">
  {imageUrl && (
    <a href={`/vrittantam/${slug}`}>
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-48 object-cover"
      />
    </a>
  )}

  <div class="p-6 flex flex-col flex-grow">
    <p class="section-label mb-2">Vṛttāntam</p>

    <h3 class="font-display text-2xl text-maroon-deep">
      <a href={`/vrittantam/${slug}`}>
        {title}
      </a>
    </h3>

    <p class="mt-2 text-sm text-stone-light">
      {date}
    </p>

    <a
      href={`/vrittantam/${slug}`}
      class="mt-6 link-underline font-ui text-sm"
    >
      Read Article →
    </a>
  </div>
</article>